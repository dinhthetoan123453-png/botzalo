# Tiền tố lệnh (Ví dụ: ! hoặc /)
BOT_PREFIX=!

# Tự động trả lời mọi tin nhắn bằng AI (true/false)
# Nếu đặt false, bot chỉ trả lời khi dùng lệnh (ví dụ !ai <câu hỏi>)
AUTO_REPLY_AI=false

# Google Gemini API Key (Không bắt buộc, chỉ cần nếu dùng tính năng AI chatbot)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mô hình Gemini sử dụng (mặc định gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Thời gian nghỉ ngẫu nhiên (ms) trước khi gửi phản hồi để chống checkpoint/spam
SAFE_DELAY_MIN=1000
SAFE_DELAY_MAX=2500
